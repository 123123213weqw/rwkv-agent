{
  "annotations": { "list": [] },
  "editable": false,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "type": "stat",
      "title": "Ready Workers",
      "id": 1,
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 0 },
      "targets": [{ "expr": "statepool_ready_workers", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "values": false } }
    },
    {
      "type": "stat",
      "title": "Pending Cloud Requests",
      "id": 2,
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 0 },
      "targets": [{ "expr": "statepool_pending_requests", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "values": false } }
    },
    {
      "type": "stat",
      "title": "Estimated Decode Backlog",
      "id": 3,
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 0 },
      "targets": [{ "expr": "statepool_estimated_decode_seconds", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "values": false } }
    },
    {
      "type": "stat",
      "title": "GPU Seconds (total)",
      "id": 4,
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 0 },
      "targets": [{ "expr": "statepool_gpu_seconds_total", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "values": false } }
    },
    {
      "type": "stat",
      "title": "Prefill Tokens Avoided",
      "id": 5,
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 0 },
      "targets": [{ "expr": "statepool_prefill_tokens_avoided_total", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "values": false } }
    },
    {
      "type": "stat",
      "title": "Estimated Cost",
      "id": 6,
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 0 },
      "targets": [{ "expr": "statepool_estimated_cost_total{currency=\"$currency\"}", "legendFormat": "{{currency}}", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "currencyCNY" }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "values": false } }
    },
    {
      "type": "timeseries",
      "title": "Actual Inference Throughput by Zone",
      "id": 7,
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "targets": [
        { "expr": "rate(statepool_usage_requests_total{zone=\"local\"}[5m])", "legendFormat": "local", "refId": "A" },
        { "expr": "rate(statepool_usage_requests_total{zone=\"edge\"}[5m])", "legendFormat": "edge", "refId": "B" },
        { "expr": "rate(statepool_usage_requests_total{zone=\"cloud\"}[5m])", "legendFormat": "cloud", "refId": "C" }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] }
    },
    {
      "type": "timeseries",
      "title": "State Tier Events",
      "id": 8,
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "targets": [
        { "expr": "rate(statepool_hot_state_hits_total[5m])", "legendFormat": "Hot reuse", "refId": "A" },
        { "expr": "rate(statepool_warm_state_hits_total[5m])", "legendFormat": "Warm restore", "refId": "B" },
        { "expr": "rate(statepool_cold_state_hits_total[5m])", "legendFormat": "Cold restore", "refId": "C" },
        { "expr": "rate(statepool_transcript_reprefills_total[5m])", "legendFormat": "Re-prefill", "refId": "D" }
      ],
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] }
    },
    {
      "type": "timeseries",
      "title": "State I/O Bytes",
      "id": 9,
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "targets": [
        { "expr": "rate(statepool_state_bytes_read_total[5m])", "legendFormat": "read", "refId": "A" },
        { "expr": "rate(statepool_state_bytes_written_total[5m])", "legendFormat": "written", "refId": "B" }
      ],
      "fieldConfig": { "defaults": { "unit": "Bps" }, "overrides": [] }
    },
    {
      "type": "timeseries",
      "title": "State Safety Operations",
      "id": 10,
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "targets": [
        { "expr": "rate(statepool_leases_acquired_total[5m])", "legendFormat": "Lease acquired", "refId": "A" },
        { "expr": "rate(statepool_lease_conflicts_total[5m])", "legendFormat": "Lease conflict", "refId": "B" },
        { "expr": "rate(statepool_snapshots_committed_total[5m])", "legendFormat": "Snapshot", "refId": "C" },
        { "expr": "rate(statepool_restores_completed_total[5m])", "legendFormat": "Restore", "refId": "D" }
      ],
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] }
    },
    {
      "type": "stat",
      "title": "State Restore Hit Ratio",
      "description": "Warm/Cold/Hot state hits divided by state hits plus transcript re-prefill events; excludes first-turn creates.",
      "id": 11,
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 20 },
      "targets": [{ "expr": "(statepool_hot_state_hits_total + statepool_warm_state_hits_total + statepool_cold_state_hits_total) / clamp_min(statepool_hot_state_hits_total + statepool_warm_state_hits_total + statepool_cold_state_hits_total + statepool_transcript_reprefills_total, 1)", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1 }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "values": false } }
    }
  ],
  "refresh": "5s",
  "schemaVersion": 41,
  "tags": ["rwkv", "statepool", "finops"],
  "templating": {
    "list": [
      {
        "name": "currency",
        "label": "Currency",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "statepool-prometheus" },
        "query": { "query": "label_values(statepool_estimated_cost_total, currency)", "refId": "StatePoolCurrency" },
        "current": { "text": "CNY", "value": "CNY" },
        "refresh": 1
      }
    ]
  },
  "time": { "from": "now-1h", "to": "now" },
  "timezone": "browser",
  "title": "RWKV StatePool / Stateful Serverless Agent",
