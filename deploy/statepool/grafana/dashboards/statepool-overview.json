    {
      "type": "timeseries",
      "title": "Placement Throughput",
      "id": 7,
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "targets": [
        { "expr": "rate(statepool_local_plans_total[5m])", "legendFormat": "local", "refId": "A" },
        { "expr": "rate(statepool_remote_plans_total[5m])", "legendFormat": "cloud/edge", "refId": "B" },
        { "expr": "rate(statepool_rejected_plans_total[5m])", "legendFormat": "rejected", "refId": "C" }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] }
    },
    {
      "type": "timeseries",
      "title": "State Tier Events",
      "id": 8,
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "targets": [
        { "expr": "rate(statepool_hot_state_hits_total[5m])", "legendFormat": "Hot reuse", "refId": "A" },
        { "expr": "rate(statepool_warm_state_hits_total[5m])", "legendFormat": "Warm restore", "refId": "B" },
        { "expr": "rate(statepool_cold_state_hits_total[5m])", "legendFormat": "Cold restore", "refId": "C" },
        { "expr": "rate(statepool_transcript_reprefills_total[5m])", "legendFormat": "Re-prefill", "refId": "D" }
      ],
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] }
    },
    {
      "type": "timeseries",
      "title": "State I/O Bytes",
      "id": 9,
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "targets": [
        { "expr": "rate(statepool_state_bytes_read_total[5m])", "legendFormat": "read", "refId": "A" },
        { "expr": "rate(statepool_state_bytes_written_total[5m])", "legendFormat": "written", "refId": "B" }
      ],
      "fieldConfig": { "defaults": { "unit": "Bps" }, "overrides": [] }
    },
    {
      "type": "timeseries",
      "title": "State Safety Operations",
      "id": 10,
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "targets": [
        { "expr": "rate(statepool_leases_acquired_total[5m])", "legendFormat": "Lease acquired", "refId": "A" },
        { "expr": "rate(statepool_lease_conflicts_total[5m])", "legendFormat": "Lease conflict", "refId": "B" },
        { "expr": "rate(statepool_snapshots_committed_total[5m])", "legendFormat": "Snapshot", "refId": "C" },
        { "expr": "rate(statepool_restores_completed_total[5m])", "legendFormat": "Restore", "refId": "D" }
      ],
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] }
    }
  ],
