{
  "database": "data/search.db",
  "search": {
    "candidate_limit": 100,
    "result_limit": 10,
    "per_domain_limit": 2,
    "evidence_limit": 8,
    "evidence_character_budget": 18000
  },
  "model": {
    "enabled": false,
    "path": "",
    "label": "RWKV",
    "device": "cuda",
    "dtype": "fp16",
    "native_model": false,
    "max_input_tokens": 8192,
    "max_new_tokens": 640,
    "repair_once": true
  },
  "realtime_search": {
    "enabled": true,
    "searxng_url": "",
    "fallback_engines": ["bing"],
    "bing_base_url": "https://cn.bing.com",
    "global_concurrency": 4,
    "per_host_concurrency": 2,
    "force_ipv4": true,
    "connect_timeout_seconds": 1.5,
    "page_timeout_seconds": 5.0,
    "discovery_timeout_seconds": 3.5,
    "max_redirects": 5,
    "max_compressed_bytes": 2097152,
    "max_decompressed_bytes": 4194304,
    "fast_max_queries": 2,
    "fast_max_candidates": 20,
    "fast_max_fetch_pages": 6,
    "fast_deadline_seconds": 12.0,
    "deep_max_queries": 2,
    "deep_max_candidates": 20,
    "deep_max_fetch_pages": 6,
    "deep_deadline_seconds": 12.0,
    "candidate_admission_enabled": true,
    "candidate_pool_multiplier": 1,
    "candidate_per_domain_limit": 3,
    "source_channels_enabled": false,
    "domain_pivot_enabled": false,
    "one_hop_link_expansion_enabled": false,
    "search_cache_ttl_seconds": 120,
    "page_cache_ttl_seconds": 300,
    "cache_max_bytes": 67108864,
    "allow_private_networks": false
  }
}
