{
  "database": "data/search.db",
  "crawler": {
    "user_agent": "RWKVLocalSearchBot/0.1 (+local-research)",
    "global_concurrency": 8,
    "per_host_concurrency": 2,
    "per_host_delay_seconds": 0.75,
    "timeout_seconds": 15.0,
    "max_response_bytes": 4194304,
    "max_pages_per_run": 200,
    "max_depth": 2,
    "max_links_per_page": 200,
    "robots_cache_seconds": 86400,
    "allow_private_networks": false
  },
  "search": {
    "candidate_limit": 100,
    "result_limit": 10,
    "per_domain_limit": 4,
    "evidence_limit": 8,
    "evidence_character_budget": 18000,
    "passage_selection_enabled": true,
    "passage_min_document_chars": 700,
    "passage_target_chars": 900,
    "passage_hard_max_chars": 1400,
    "passage_max_per_document": 3,
    "passage_max_chars_per_evidence": 3200
  },
  "model": {
    "enabled": false,
    "path": "",
    "label": "RWKV",
    "device": "cuda",
    "dtype": "fp16",
    "native_model": false,
    "max_input_tokens": 8192,
    "max_new_tokens": 640,
    "repair_once": true
  },
  "realtime_search": {
    "enabled": false,
    "searxng_url": "http://127.0.0.1:8888",
    "searxng_engines": ["dogpile", "naver"],
    "searxng_language_engines": {"zh": ["baidu"], "default": ["yandex"]},
    "fallback_engines": ["bing"],
    "global_concurrency": 8,
    "per_host_concurrency": 2,
    "force_ipv4": false,
    "connect_timeout_seconds": 1.5,
    "page_timeout_seconds": 5.0,
    "discovery_timeout_seconds": 3.5,
    "max_redirects": 5,
    "response_header_max_bytes": 32768,
    "max_compressed_bytes": 2097152,
    "max_decompressed_bytes": 4194304,
    "fast_max_queries": 2,
    "fast_max_candidates": 30,
    "fast_max_fetch_pages": 8,
    "fast_deadline_seconds": 8.0,
    "deep_max_queries": 4,
    "deep_max_candidates": 60,
    "deep_max_fetch_pages": 20,
    "deep_deadline_seconds": 30.0,
    "candidate_admission_enabled": true,
    "candidate_pool_multiplier": 2,
    "candidate_per_domain_limit": 3,
    "query_compaction_enabled": false,
    "source_channels_enabled": false,
    "domain_pivot_enabled": false,
    "domain_pivot_max_domains": 2,
    "domain_pivot_max_candidates": 20,
    "domain_pivot_timeout_seconds": 3.5,
    "one_hop_link_expansion_enabled": false,
    "one_hop_max_links": 8,
    "snippet_fallback_enabled": true,
    "snippet_fallback_min_chars": 96,
    "snippet_fallback_min_cjk_chars": 48,
    "snippet_fallback_min_candidate_score": 0.18,
    "snippet_fallback_min_entity_coverage": 0.5,
    "snippet_fallback_entity_bypass_score": 0.42,
    "snippet_fallback_on_extraction_error": true,
    "search_cache_ttl_seconds": 120,
    "page_cache_ttl_seconds": 300,
    "cache_max_bytes": 67108864,
    "allow_private_networks": false
  },
  "shadow_search": {
    "enabled": false,
    "endpoint": "http://127.0.0.1:19220",
    "index": "rwkv-finewiki-zh-full-v1",
    "timeout_seconds": 3.0,
    "limit": 10,
    "channel_size": 50,
    "sample_rate": 1.0,
    "max_workers": 2,
    "log_path": "data/shadow/finewiki-shadow-v1.jsonl",
    "max_log_bytes": 67108864,
    "passage_hydration_enabled": false,
    "passage_max_pages": 8,
    "passage_chunks_per_page": 12,
    "passage_max_chars": 3200,
    "passage_model": "BAAI/bge-reranker-v2-m3",
    "passage_device": "auto",
    "passage_batch_size": 16,
    "passage_max_length": 512,
    "passage_fp16": true,
    "passage_local_files_only": true
  }
}
