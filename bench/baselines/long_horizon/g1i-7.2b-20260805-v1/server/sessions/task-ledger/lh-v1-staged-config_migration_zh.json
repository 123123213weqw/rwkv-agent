        "acceptance_criteria": [
          "完整隐藏于实现之外的验证程序成功。"
        ],
        "constraints": [
          "不得修改 validator.py。"
        ],
        "verification_commands": [
          "python3 validator.py"
        ],
        "requires_mutation": false
      }
    ]
