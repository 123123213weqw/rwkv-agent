    "schema_version": 1,
    "objective": "只在long-horizon/staged/config_migration_zh中工作。完成配置格式迁移：先检查规范、旧配置和验证程序，建立迁移脚本 migrate.py；再迁移 service.json 与 worker.json；最后运行完整验证并生成 migration-report.json。不得手工硬编码两个最终文件，也不得修改 validator.py。全部验证成功后才能结束。",
    "acceptance_criteria": [
      "可复用迁移脚本存在并实际处理两个配置。",
      "validator.py 输出 MIGRATION_OK。"
    ],
    "constraints": [
      "不得修改 validator.py。",
      "不得用常量整体覆盖两个配置文件。"
    ],
    "verification_commands": [
      "python3 validator.py"
    ],
    "requires_mutation": true,
    "working_directory": "long-horizon/staged/config_migration_zh",
    "stages": [
      {
        "id": "build_migrator",
        "objective": "阅读 SPEC.md、两个旧配置和 validator.py，编写可复用的 migrate.py。用 --check 模式或等价的非破坏检查证明脚本可以解析两个输入。",
        "depends_on": [],
        "acceptance_criteria": [
          "migrate.py 能接受文件路径参数并解析旧配置。"
        ],
        "constraints": [
          "不得修改 validator.py 或现有 JSON。"
        ],
        "verification_commands": [
          "python3 migrate.py --check service.json worker.json"
        ],
        "requires_mutation": true
      },
      {
        "id": "apply_migration",
        "objective": "使用 migrate.py 迁移 service.json 和 worker.json，并检查两个结果都符合 SPEC.md；同时生成 migration-report.json。",
        "depends_on": [
          "build_migrator"
        ],
        "acceptance_criteria": [
          "两个配置由脚本迁移且报告已生成。"
        ],
        "constraints": [
          "不得修改 validator.py。"
        ],
        "verification_commands": [
          "python3 migrate.py service.json worker.json && python3 -c \"import json; from pathlib import Path; assert all(json.loads(Path(p).read_text())['schema_version']==2 for p in ('service.json','worker.json')); print('APPLY_OK')\""
        ],
        "requires_mutation": true
      },
      {
        "id": "validate_migration",
        "objective": "运行完整 validator.py；若失败则根据真实错误修复迁移实现或产物，直到输出 MIGRATION_OK。",
        "depends_on": [
          "apply_migration"
