# Copy to ~/.config/rwkv-agent/rwkv-agent.env and replace every /absolute/path.
# This file is a shell environment file. Never commit the populated copy.

RWKV_AGENT_PROJECT_ROOT=/absolute/path/to/rwkv-agent
RWKV_AGENT_PYTHON=/absolute/path/to/rwkv-agent/.venv/bin/python

# Replace these values with one jointly verified checkpoint/runtime profile.
G1I_MODEL_PATH=/absolute/path/to/rwkv-model.pth
G1I_RUNTIME_DIR=/absolute/path/to/albatross-runtime
G1I_MODEL_ID=verified-model-id
G1I_CONTEXT=16384
G1I_STATE_CAPACITY=8
G1I_PERSISTENT_STATE_CAPACITY=8
G1I_PERSISTENT_STATE_TTL_SECONDS=600
CUDA_VISIBLE_DEVICES=0

RWKV_AGENT_HOST=127.0.0.1
RWKV_AGENT_PORT=8122
RWKV_AGENT_MODEL_URLS=http://127.0.0.1:8417
RWKV_AGENT_DATA_PLANE_URL=http://127.0.0.1:8121
RWKV_AGENT_SESSION_DIR=/absolute/path/to/rwkv-agent-state/sessions
RWKV_AGENT_WEB_CONFIG=/absolute/path/to/rwkv-agent/configs/production.example.json
RWKV_AGENT_TOOL_GATE_THRESHOLD=-3.2
RWKV_AGENT_CHAT_STATE_CAPACITY=3
RWKV_AGENT_WEB_API_PROVIDERS=github,mediawiki,crossref
RWKV_AGENT_WEB_FALLBACK_ENGINES=bing

# Optional. Leave empty to use GitHub/MediaWiki/Crossref and the configured fallback.
TAVILY_API_KEY=
GITHUB_TOKEN=

# Optional local services and runtime storage.
# Knowledge download and index setup: docs/KNOWLEDGE_SETUP.md
RWKV_AGENT_KNOWLEDGE_ENDPOINT=http://127.0.0.1:19220
TORCH_EXTENSIONS_DIR=/absolute/path/to/rwkv-agent-state/torch-extensions

# Optional Rust StatePool Cloud Plugin. The default remains disabled.
RWKV_AGENT_CLOUD_PLUGIN=false
RWKV_AGENT_CLOUD_PLUGIN_URL=http://127.0.0.1:8130
RWKV_AGENT_CLOUD_PLUGIN_FALLBACK=local
RWKV_AGENT_CLOUD_PLUGIN_PRIVACY=local_only
RWKV_AGENT_CLOUD_PLUGIN_LATENCY_SLO_MS=5000
# Preferred zone is optional; set all four model identity values when enabling.
RWKV_AGENT_CLOUD_PLUGIN_PREFERRED_ZONE=
RWKV_AGENT_CLOUD_MODEL_ID=
RWKV_AGENT_CLOUD_MODEL_REVISION=
RWKV_AGENT_CLOUD_TOKENIZER=
RWKV_AGENT_CLOUD_STATE_ABI=
# Experimental Controller lifecycle transport. This remains independently
# opt-in even when placement is enabled.
RWKV_AGENT_CLOUD_STATE_LIFECYCLE=false
RWKV_AGENT_CLOUD_STATE_TARGET_TIER=cold
RWKV_AGENT_CLOUD_LEASE_TTL_SECONDS=120
RWKV_AGENT_CLOUD_LIFECYCLE_TIMEOUT_SECONDS=180

# Optional Sidecar-as-StatePool-Worker mode. Leave RWKV_STATEPOOL_URL empty to
# preserve the ordinary local Sidecar with no registration thread or drain gate.
RWKV_STATEPOOL_URL=
RWKV_WORKER_ID=
RWKV_WORKER_ENDPOINT=http://127.0.0.1:8118
RWKV_WORKER_ZONE=local
RWKV_WORKER_MODEL_ID=
RWKV_WORKER_MODEL_REVISION=
RWKV_WORKER_TOKENIZER=
RWKV_WORKER_STATE_ABI=
RWKV_WORKER_STATE_SLOTS=8
RWKV_WORKER_MAX_BATCH=8
RWKV_WORKER_HEARTBEAT_SECONDS=5
RWKV_WORKER_DEVICE_VENDOR=
RWKV_WORKER_DEVICE_MODEL=
RWKV_WORKER_DEVICE_RUNTIME=
RWKV_WORKER_DEVICE_MEMORY_BYTES=0

# OpenAI/vLLM Worker Adapter configuration lives in the independent
# https://github.com/123123213weqw/statepool-cloud product repository.
