{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rwkv-search.local/contracts/source.schema.json",
  "title": "RWKV Search Source v1",
  "type": "object",
  "required": ["id", "title", "url", "snippet", "source_type"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "title": {"type": "string"},
    "url": {"type": "string"},
    "snippet": {"type": "string"},
    "source_type": {"type": "string"},
    "published_at": {"type": ["string", "null"]},
    "updated_at": {"type": ["string", "null"]},
    "fetched_at": {"type": ["number", "string", "null"]},
    "authority": {"type": ["number", "null"]},
    "score": {"type": ["number", "null"]},
    "matched_channels": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": true
}
