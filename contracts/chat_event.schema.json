{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rwkv-search.local/contracts/chat_event.schema.json",
  "title": "RWKV Search SSE Event v1",
  "type": "object",
  "required": ["schema_version", "type", "request_id", "conversation_id", "message_id", "sequence", "timestamp"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "type": {
      "enum": [
        "request_started", "route", "search_plan", "discovery_progress",
        "fetch_progress", "evidence_ready", "generation_started",
        "answer_delta", "answer_final", "warning", "error", "done"
      ]
    },
    "request_id": {"type": "string", "minLength": 1},
    "conversation_id": {"type": "string", "minLength": 1},
    "message_id": {"type": "string", "minLength": 1},
    "sequence": {"type": "integer", "minimum": 1},
    "timestamp": {"type": "string", "format": "date-time"},
    "route": {"type": "object"},
    "plan": {"type": "object"},
    "progress": {"type": "object"},
    "sources": {"type": "array", "items": {"$ref": "source.schema.json"}},
    "answer": {
      "type": "object",
      "required": ["content", "citations", "data_time", "insufficient_evidence", "needs_clarification"],
      "properties": {
        "content": {"type": "string"},
        "citations": {"type": "array", "items": {"type": "string"}},
        "data_time": {"type": "string"},
        "insufficient_evidence": {"type": "boolean"},
        "needs_clarification": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "delta": {"type": "string"},
    "state": {"type": "string"},
    "usage": {"type": "object"},
    "model": {"type": ["object", "null"]},
    "error": {"type": "object"}
  },
  "additionalProperties": true
}
