{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rwkv-agent.local/contracts/usage-record-v1.schema.json",
  "title": "StatePool Usage Record v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "record_id",
    "request_id",
    "session_id",
    "owner_id",
    "worker_id",
    "zone",
    "operation",
    "outcome",
    "started_at_ms",
    "finished_at_ms",
    "metrics"
  ],
  "properties": {
    "contract_version": { "const": "statepool-usage-record.v1" },
    "record_id": { "type": "string", "minLength": 1 },
    "request_id": { "type": "string", "minLength": 1 },
    "session_id": { "type": "string", "minLength": 1 },
    "owner_id": { "type": "string", "minLength": 1 },
    "worker_id": { "type": "string", "minLength": 1 },
    "zone": { "enum": ["local", "edge", "cloud"] },
    "operation": { "enum": ["create", "continue", "snapshot", "restore", "release", "drain"] },
    "outcome": { "enum": ["succeeded", "failed", "cancelled", "unknown"] },
    "state_tier_before": { "type": ["string", "null"], "enum": ["hot", "warm", "cold", "dropped", null] },
    "state_tier_after": { "type": ["string", "null"], "enum": ["hot", "warm", "cold", "dropped", null] },
    "started_at_ms": { "type": "integer", "minimum": 0 },
    "finished_at_ms": { "type": "integer", "minimum": 0 },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "elapsed_ms",
        "input_tokens",
        "output_tokens",
        "prefill_tokens_avoided",
        "gpu_seconds",
        "state_bytes_read",
        "state_bytes_written"
      ],
      "properties": {
        "elapsed_ms": { "type": "number", "minimum": 0 },
        "queue_ms": { "type": "number", "minimum": 0 },
        "restore_ms": { "type": "number", "minimum": 0 },
        "snapshot_ms": { "type": "number", "minimum": 0 },
        "input_tokens": { "type": "integer", "minimum": 0 },
        "output_tokens": { "type": "integer", "minimum": 0 },
        "prefill_tokens_avoided": { "type": "integer", "minimum": 0 },
        "gpu_seconds": { "type": "number", "minimum": 0 },
        "state_bytes_read": { "type": "integer", "minimum": 0 },
        "state_bytes_written": { "type": "integer", "minimum": 0 },
        "estimated_cost": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["currency", "amount"],
          "properties": {
            "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
            "amount": { "type": "number", "minimum": 0 }
          }
        }
      }
    },
    "error_code": { "type": ["string", "null"] }
  }
}
